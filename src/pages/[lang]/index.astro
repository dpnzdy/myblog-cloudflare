---
import Layout from '../../layouts/Layout.astro';
import AppPromo from '../../components/AppPromo.astro';
import PostCard from '../../components/PostCard.astro';
import Topics from '../../components/Topics.astro';
import { copy } from '../../lib/copy';
import { localPosts, publishedPosts } from '../../lib/posts';
import { allLanguages, blogPath, brand, homePath, languages } from '../../lib/site';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = copy[lang];
const guides = localPosts(await publishedPosts(), lang);
const startKeys = ['open-rtf', 'offline-notes', 'getting-started'];
const starter = startKeys.flatMap((key) => guides.find((post) => post.data.translationKey === key) ?? []);
const starterKeys = new Set(starter.map(({ data }) => data.translationKey));
const latest = guides.filter(({ data }) => !starterKeys.has(data.translationKey)).slice(0, 3);
---
<Layout {lang} title={brand} description={t.heroBody} path={homePath(lang)} alternates={allLanguages(homePath)}>
  <div class="wrap">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <h1 id="home-title"><span>{t.heroLead}</span><em>{t.heroAccent}</em></h1>
        <p>{t.heroBody}</p>
        <a class="button" href={blogPath(lang)}>{t.browse}</a>
      </div>
      <img class="hero-image" src="/images/hero.webp" width="1260" height="840" alt="" fetchpriority="high" decoding="async" />
    </section>
    <section class="home-guides" aria-labelledby="start-title">
      <div class="section-heading">
        <h2 id="start-title">{t.featured}</h2>
        <a class="text-link" href={blogPath(lang)}>{t.allGuides}</a>
      </div>
      <Topics {lang} />
      <div class="post-grid">{starter.map((post) => <PostCard {post} eager />)}</div>
    </section>
    {latest.length > 0 && (
      <section class="home-guides" aria-labelledby="latest-title">
        <div class="section-heading"><h2 id="latest-title">{t.latest}</h2></div>
        <div class="post-grid">{latest.map((post) => <PostCard {post} />)}</div>
      </section>
    )}
    <AppPromo {lang} />
  </div>
</Layout>
