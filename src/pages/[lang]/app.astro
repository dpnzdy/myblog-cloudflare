---
import Layout from '../../layouts/Layout.astro';
import { copy } from '../../lib/copy';
import { allLanguages, appPath, brand, guidePath, languageNames, languages, store } from '../../lib/site';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = copy[lang];
const appLanguages = { ko: '앱 표시 언어', en: 'App interface languages', de: 'Sprachen der App-Oberfläche',
  es: 'Idiomas de la interfaz', fr: 'Langues de l’interface', ja: 'アプリの表示言語' };
---
<Layout {lang} title={t.app} description={t.appIntro} path={appPath(lang)} alternates={allLanguages(appPath)}
  section="app" image="/images/app-editor.webp" imageAlt={t.editorAlt}>
  <div class="wrap product">
    <header class="product-header">
      <img src="/images/app-icon.webp" width="58" height="58" alt="" />
      <span class="category-label">{brand}</span>
      <h1>{t.appHeading}</h1>
      <p>{t.appIntro}</p>
      <a class="button" href="#editions">{t.editions}</a>
    </header>
    <figure class="product-screenshot">
      <img src="/images/app-editor.webp" width="1600" height="1000" alt={t.editorAlt} fetchpriority="high" decoding="async" />
      <figcaption>{t.editorLabel}</figcaption>
    </figure>
    <section class="product-section" aria-labelledby="features-title">
      <div class="section-heading"><h2 id="features-title">{t.features}</h2></div>
      <div class="feature-grid">
        {t.featureNames.map((name, i) => (
          <div><h3>{name}</h3><p>{t.featureBodies[i]}</p></div>
        ))}
      </div>
    </section>
    <section class="product-section" id="editions" aria-labelledby="editions-title">
      <div class="section-heading"><h2 id="editions-title">{t.editions}</h2></div>
      <div class="edition-grid">
        <article><h3>Free</h3><p>{t.freeText}</p><a class="button" href={store.free} data-umami-event="store-click"
          data-umami-event-edition="free" data-umami-event-language={lang}>{t.free}</a></article>
        <article><h3>Pro</h3><p>{t.proText}</p><a class="button button-outline" href={store.pro} data-umami-event="store-click"
          data-umami-event-edition="pro" data-umami-event-language={lang}>{t.pro}</a></article>
      </div>
      <dl class="app-specs">
        <div><dt>{t.system}</dt><dd>{t.systemText}</dd></div>
        <div><dt>{appLanguages[lang]}</dt><dd>{languages.map((code, i) => <>{i > 0 && ' · '}<span lang={code}>{languageNames[code]}</span></>)}</dd></div>
      </dl>
      <a class="text-link" href={guidePath(lang)}>{t.guide}</a>
    </section>
  </div>
</Layout>
