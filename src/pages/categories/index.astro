---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryNames, getPublishedPosts } from '../../lib/content';
const posts = await getPublishedPosts();
---
<BaseLayout title="카테고리" description="제품 리뷰, Ubuntu, Python, Codex 카테고리별 기술 글을 살펴보세요.">
  <div class="section-shell page-header"><p class="eyebrow">CATEGORIES</p><h1>카테고리</h1><p>관심 있는 분야를 골라 살펴보세요.</p></div>
  <div class="section-shell topic-grid page-content">
    {Object.entries(categoryNames).map(([slug, name], index) => <a class="topic-card" href={`/categories/${slug}/`}><span class="topic-number">0{index + 1}</span><h2>{name}</h2><p>{posts.filter((p) => p.data.category === slug).length}개의 글</p><span class="topic-arrow">→</span></a>)}
  </div>
</BaseLayout>
