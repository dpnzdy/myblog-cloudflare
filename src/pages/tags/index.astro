---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/content';
const posts = await getPublishedPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b, 'ko'));
---
<BaseLayout title="태그" description="주제와 기술 키워드별로 블로그 글을 탐색하세요.">
  <div class="section-shell page-header"><p class="eyebrow">TAGS</p><h1>태그</h1><p>세부 주제와 기술 키워드로 글을 찾을 수 있습니다.</p></div>
  <div class="section-shell tag-cloud page-content">{tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}<span>{posts.filter((p) => p.data.tags.includes(tag)).length}</span></a>)}</div>
</BaseLayout>
