---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { categoryNames, getPublishedPosts } from '../lib/content';

const posts = await getPublishedPosts();
const featured = posts.filter((post) => post.data.featured);
const latest = (featured.length ? featured : posts).slice(0, 3);
---

<BaseLayout title="기술 생활 기록" description="IT 제품 리뷰와 Ubuntu, Python, Codex 활용법을 직접 확인하고 정리합니다.">
  <section class="hero section-shell">
    <p class="eyebrow">REVIEW · BUILD · LEARN</p>
    <h1>도구를 직접 써보고,<br /><span>쓸모 있는 답을 기록합니다.</span></h1>
    <p class="hero-copy">IT 제품의 솔직한 리뷰부터 Ubuntu 문제 해결, Python 자동화, Codex 활용법까지 검증한 경험을 공유합니다.</p>
    <div class="hero-actions">
      <a class="button primary" href="/posts/">최신 글 읽기</a>
      <a class="button secondary" href="/about/">블로그 소개</a>
    </div>
  </section>

  <section class="section-shell section-block" aria-labelledby="topics-heading">
    <div class="section-heading">
      <div><p class="eyebrow">TOPICS</p><h2 id="topics-heading">관심 분야부터 둘러보세요</h2></div>
    </div>
    <div class="topic-grid">
      {Object.entries(categoryNames).map(([slug, name], index) => (
        <a class="topic-card" href={`/categories/${slug}/`}>
          <span class="topic-number">0{index + 1}</span>
          <h3>{name}</h3>
          <p>{slug === 'reviews' ? '직접 사용한 제품의 장단점' : `${name} 설정과 실전 활용법`}</p>
          <span class="topic-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section-shell section-block" aria-labelledby="latest-heading">
    <div class="section-heading">
      <div><p class="eyebrow">LATEST STORIES</p><h2 id="latest-heading">새로 올라온 글</h2></div>
      <a class="text-link" href="/posts/">모든 글 보기 →</a>
    </div>
    <PostList posts={latest} />
  </section>
</BaseLayout>
