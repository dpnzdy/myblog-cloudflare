---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  eager?: boolean;
  variant?: 'hero' | 'content';
}

const { src, alt, caption, eager = false, variant = 'content' } = Astro.props;
const sizes = variant === 'hero'
  ? '(max-width: 52rem) calc(100vw - 2rem), 50rem'
  : '(max-width: 49rem) calc(100vw - 2rem), 47rem';
---

<figure class:list={['blog-image', `blog-image--${variant}`]}>
  <Image
    src={src}
    alt={alt}
    widths={[480, 768, 1200, 1600]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
  <figcaption>{caption}</figcaption>
</figure>
