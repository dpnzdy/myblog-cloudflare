---
import type { Post } from '../lib/content';
import PostCard from './PostCard.astro';

interface Props { posts: Post[]; emptyMessage?: string }
const { posts, emptyMessage = '아직 공개된 글이 없습니다.' } = Astro.props;
---

{posts.length > 0 ? (
  <div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div>
) : (
  <p class="empty-state">{emptyMessage}</p>
)}
